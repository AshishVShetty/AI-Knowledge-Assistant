# Virtual Environment
venv/
.venv/
env/
ENV/

# Python & Caches
__pycache__/
*.py[cod]
*$py.class
*.pyd
.pytest_cache/

# Environment Variables & Secrets (CRITICAL)
.env
.env.*
!.env.example
backend/.env
backend/.env.*
