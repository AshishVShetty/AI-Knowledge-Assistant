backend/uploads/*
!backend/uploads/.gitkeep
uploads/*
!uploads/.gitkeep

# Node.js & Frontend Build Artifacts
node_modules/
frontend/node_modules/
dist/
frontend/dist/
build/
.npm/

# IDE & OS Files
.DS_Store
Thumbs.db
